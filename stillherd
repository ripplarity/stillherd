#!/usr/bin/env bash
# stillherd: one-screen status. Usage: stillherd status | today | timeline | explain | audit <tool>
HOOKS="$(cd "$(dirname "$0")/../hooks" 2>/dev/null && pwd)"
PY=python3; command -v python3 >/dev/null 2>&1 || PY=python
section() {  # title, script, args...
  local title="$1" script="$2"; shift 2
  echo "== $title"
  if [ -z "$HOOKS" ] || [ ! -f "$HOOKS/$script" ]; then echo "  (unavailable)"; return 0; fi
  out=$(timeout 20 "$PY" "$HOOKS/$script" "$@" 2>&1); rc=$?
  if [ $rc -ne 0 ] && [ -z "$out" ]; then echo "  (unavailable, rc=$rc)"; return 0; fi
  printf '%s\n' "$out" | head -n 12 | sed 's/^/  /'
}
case "${1:-status}" in
  status)
    echo "stillherd status"
    section "CPU leases" cpu_lease.py status
    section "GPU lease" gpu_lease.py status
    section "Ledger (running)" activity_ledger.py list
    section "Orphan candidates" proc_tree.py orphans
    ;;
  today)
    shift; D="$(cd "$(dirname "$0")" && pwd)"
    T="$D/today.py"; [ -f "$T" ] || T="$D/bin/today.py"
    [ -f "$T" ] || { echo "today.py not found next to this script" >&2; exit 1; }
    exec "$PY" "$T" "$@" ;;
  timeline|explain)
    D="$(cd "$(dirname "$0")" && pwd)"
    T="$D/timeline.py"; [ -f "$T" ] || T="$D/bin/timeline.py"
    [ -f "$T" ] || { echo "timeline.py not found next to this script" >&2; exit 1; }
    exec "$PY" -I "$T" "$@" ;;
  audit)
    shift; D="$(cd "$(dirname "$0")" && pwd)"
    A="${STILLHERD_REPO:-$D}/egress/audit.sh"
    [ -f "$A" ] || { echo "audit needs a stillherd repo checkout: set STILLHERD_REPO=/path/to/checkout" >&2; exit 1; }
    exec bash "$A" "$@" ;;
  watch)
    shift; D="$(cd "$(dirname "$0")" && pwd)"
    W="${STILLHERD_REPO:-$D}/silent/watch.sh"
    [ -f "$W" ] || { echo "watch needs a stillherd repo checkout: set STILLHERD_REPO=/path/to/checkout" >&2; exit 1; }
    [ $# -ge 1 ] || { echo "usage: stillherd watch <cmd...>" >&2; exit 2; }
    exec bash "$W" "$@" ;;
  *) echo "usage: stillherd status | today [YYYY-MM-DD] | timeline RUN_ID|--since UTC | explain RUN_ID | audit <claude|aider|opencode|goose> [--from RUN1 RUN2] | watch <cmd...>" >&2; exit 2 ;;
esac
exit 0
